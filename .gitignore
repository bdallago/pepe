# ─────────────────────────────────────────────────────────────
# Secretos y credenciales — NADA de esto puede llegar a GitHub
# ─────────────────────────────────────────────────────────────
# Todos los .env quedan afuera; solo se versiona el ejemplo.
.env
.env.*
!.env.example

# Claves, certificados y tokens sueltos
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
id_rsa*
id_ed25519*
secrets.json
secrets.*.json
credentials.json
service-account*.json
gha-creds-*.json
*.tfvars
*.tfstate
*.tfstate.*

# Estado local de las CLIs (contienen project ids y tokens de acceso)
.vercel
.netlify
.supabase/
supabase/.branches/
supabase/.temp/
supabase/config.toml.local
.firebase/

# Dumps y backups de base de datos (pueden traer datos reales)
*.sql.gz
*.dump
*.bak
dump.sql
backup*.sql

# ─────────────────────────────────────────────────────────────
# Dependencias
# ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─────────────────────────────────────────────────────────────
# Build y artefactos
# ─────────────────────────────────────────────────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts
.turbo/
.swc/

# Pesos del modelo de embeddings (~266 MB). Los baja el build con
# `npm run descargar:modelo`. No se commitean: el repo es público y
# GitHub rechaza archivos de más de 100 MB.
/.modelos/

# Estado de `npm run medir:recepcionista`. La línea base SÍ se commitea
# (docs/dev/recepcionista-linea-base.json); esto es el scratch de una
# corrida a medio hacer.
.medidas/

# ─────────────────────────────────────────────────────────────
# Testing y cobertura
# ─────────────────────────────────────────────────────────────
/coverage
/playwright-report
/test-results
/.nyc_output

# ─────────────────────────────────────────────────────────────
# Logs y debug
# ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────────────────────
# Caches de herramientas
# ─────────────────────────────────────────────────────────────
.eslintcache
.cache/
.parcel-cache/
.npm/

# ─────────────────────────────────────────────────────────────
# Editores y sistema operativo
# ─────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ─────────────────────────────────────────────────────────────
# Herramientas de agentes / scratch local
# ─────────────────────────────────────────────────────────────
.claude/settings.local.json
scratch/
tmp/
*.local

# ─────────────────────────────────────────────────────────────
# Datos personales
# ─────────────────────────────────────────────────────────────
# Export de La Colmena: son mis entradas de bitácora, no van a un repo
# público. El importador las lee de acá pero el archivo no se commitea.
colmena-backup-*.json
colmena-export.json

# Nota: `vercel link` agrega ".vercel" y ".env*" al final de este archivo.
# Ya están contemplados arriba, y ".env*" al final pisaría la excepción
# de "!.env.example" (la última regla que matchea gana). Si volvés a
# correr `vercel link`, borrá lo que agregue al pie.
