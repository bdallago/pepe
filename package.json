{
  "name": "pepe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=32768 next dev",
    "build": "npm run descargar:modelo && next build",
    "start": "cross-env NODE_OPTIONS=--max-http-header-size=32768 next start",
    "lint": "eslint",
    "descargar:modelo": "node --experimental-strip-types --conditions=react-server scripts/descargar-modelo.ts",
    "backfill:embeddings": "node --experimental-strip-types --conditions=react-server scripts/backfill-embeddings.ts",
    "medir:recepcionista": "tsx --conditions=react-server scripts/medir-recepcionista.mts",
    "import:colmena": "node --experimental-strip-types scripts/importar-colmena.ts",
    "typecheck": "tsc --noEmit",
    "verificar:doc": "tsx --conditions=react-server scripts/verificar-doc.mts",
    "test": "tsx --test \"tests/**/*.test.mts\"",
    "mcp": "tsx mcp/servidor.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.29.0",
    "mcp-handler": "^2.1.0",
    "next": "15.5.22",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0"
  }
}
